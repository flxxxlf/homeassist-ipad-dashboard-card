{
  "name": "ipad-dashboard-card",
  "version": "1.3.0",
  "private": true,
  "description": "Tabbed Home Assistant dashboard card for an iPad in landscape",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/ipad-dashboard-card.js --bundle --format=esm --target=es2020,safari15 --minify --legal-comments=eof --external:opus-encdec/* --outfile=dist/ipad-dashboard-card.js",
    "check": "node --check dist/ipad-dashboard-card.js"
  },
  "devDependencies": {
    "@sendspin/sendspin-js": "6.0.0",
    "esbuild": "0.28.2"
  }
}
